{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blastledger.example/schemas/assessment.schema.json",
  "title": "BlastLedger assessment input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "services", "change"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "services": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {"$ref": "#/$defs/service"}
    },
    "change": {"$ref": "#/$defs/change"}
  },
  "$defs": {
    "serviceId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "criticality", "dependencies"],
      "properties": {
        "id": {"$ref": "#/$defs/serviceId"},
        "criticality": {"enum": ["low", "high", "critical"]},
        "dependencies": {"type": "array", "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/serviceId"}},
        "replicas": {"type": ["integer", "null"], "minimum": 0, "maximum": 100000},
        "max_rps": {"type": ["number", "null"], "minimum": 0},
        "current_rps": {"type": ["number", "null"], "minimum": 0},
        "required_failover_rps": {"type": ["number", "null"], "minimum": 0},
        "capacity_observed_at": {"type": ["string", "null"], "format": "date"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "affected_services"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "type": {"type": "string", "minLength": 1, "maxLength": 100},
        "affected_services": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/serviceId"}},
        "rollback_ref": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  }
}
